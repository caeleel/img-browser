# Copy this file to .env.local and fill in your actual values

# Database Configuration
POSTGRES_URL_NON_POOLING=postgresql://username:password@host:port/database_name

# Digital Ocean Spaces / S3 Configuration
ACCESS_KEY_ID=your_digitalocean_access_key_id
SECRET_ACCESS_KEY=your_digitalocean_secret_access_key

# Next.js Public Environment Variables (same as above)
NEXT_PUBLIC_DO_ACCESS_KEY_ID=your_digitalocean_access_key_id
NEXT_PUBLIC_DO_SECRET_ACCESS_KEY=your_digitalocean_secret_access_key